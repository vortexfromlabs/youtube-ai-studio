# ============================================================
# VortexLabs Pro Studio — Environment Configuration
# Copy this file to .env and fill in your keys.
# ============================================================

# Groq (Agents 1,2,3,4,12) - 100% FREE - Get key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ElevenLabs (Agent 5 — primary TTS, optional - falls back to edge-tts CLI)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# YouTube Data API v3 (Agent 12)
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json

# Workspace root (all generated assets go here)
WORKSPACE_ROOT=./workspace

# Database (SQLite WAL mode - persistent memory across episodes)
DATABASE_URL=sqlite:///./vortex_pro.db

# FFmpeg binary path - LEAVE BLANK if ffmpeg is on PATH
# FIXED: Blank now safely defaults to "ffmpeg" (was causing [WinError 87])
FFMPEG_PATH=

# Logging level
LOG_LEVEL=INFO
