# ============================================================
# VortexLabs Pro Studio — Environment Configuration
# Copy this file to .env and fill in your keys.
# ============================================================

# Google Gemini (Agent 1, 2, 3, 4)
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs (Agent 5 — primary TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Hugging Face (Agent 6 — image generation, Agent 8 — video)
HF_API_TOKEN=your_huggingface_token_here

# YouTube Data API v3 (Agent 12)
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json

# Workspace root (all generated assets go here)
WORKSPACE_ROOT=./workspace

# Database
DATABASE_URL=sqlite:///./vortex_pro.db

# FFmpeg binary path (leave empty if on PATH)
FFMPEG_PATH=

# Logging level
LOG_LEVEL=INFO